{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (CPU + Vulkan GPU)"
    },
    {
      "name": "cpu",
      "inherits": "base",
      "displayName": "CPU only (no Vulkan SDK needed)",
      "cacheVariables": { "WHISPER_VTT_VULKAN": "OFF" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Optimised with debug info and the diagnostic log",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WHISPER_VTT_DEBUG": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "cpu",     "configurePreset": "cpu" },
    { "name": "debug",   "configurePreset": "debug" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": { "outputOnFailure": true }
    }
  ]
}
